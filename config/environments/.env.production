# Production Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lockr_db_prod
DB_USER=root
DB_PASSWORD=

# Node.js Server
NODE_ENV=production
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT Secret (use a strong secret!)
JWT_SECRET=prod_secret_key_use_strong_random_string

# File Upload Path
UPLOAD_PATH=./backend/uploads/