{
  "info": {
    "name": "LockR PHP Upload API - Fixed",
    "_postman_id": "lockr-php-upload-fixed-2026",
    "description": "Fixed test suite for PHP file upload endpoints with correct paths",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "php_base_url",
      "value": "http://localhost/lockr-backend/php",
      "type": "string",
      "description": "Update this after running setup-xampp-link.ps1"
    },
    {
      "key": "node_api_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_reservation_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "current_student_id",
      "value": "2024-00001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup - Get Token",
      "item": [
        {
          "name": "Login and Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    pm.collectionVariables.set('current_student_id', response.user.studentID);",
                  "    console.log('Token:', response.token);",
                  "    console.log('Student ID:', response.user.studentID);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.student@iacademy.edu.ph\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{node_api_url}}/auth/login",
              "host": ["{{node_api_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. PHP Backend Health Check",
      "item": [
        {
          "name": "Test PHP Backend Connectivity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('PHP backend is accessible', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Test results returned', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    console.log('PHP Backend Status:', JSON.stringify(response.data, null, 2));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{php_base_url}}/api/test.php",
              "host": ["{{php_base_url}}"],
              "path": ["api", "test.php"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Upload Tests",
      "item": [
        {
          "name": "TC5.1 - Upload Proof of Payment (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Upload successful', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Filename returned', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data).to.have.property('filename');",
                  "    console.log('Uploaded file:', response.data.filename);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "proofOfPayment",
                  "type": "file",
                  "src": [],
                  "description": "Select a PDF, JPG, or PNG file"
                },
                {
                  "key": "reservation_id",
                  "value": "{{test_reservation_id}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{php_base_url}}/api/upload.php",
              "host": ["{{php_base_url}}"],
              "path": ["api", "upload.php"]
            }
          }
        },
        {
          "name": "TC5.2 - Upload Proof of Payment - No File (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message present', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.message).to.include('file');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "reservation_id",
                  "value": "{{test_reservation_id}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{php_base_url}}/api/upload.php",
              "host": ["{{php_base_url}}"],
              "path": ["api", "upload.php"]
            }
          }
        },
        {
          "name": "TC5.3 - Upload - Unauthorized (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "proofOfPayment",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "reservation_id",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{php_base_url}}/api/upload.php",
              "host": ["{{php_base_url}}"],
              "path": ["api", "upload.php"]
            }
          }
        }
      ]
    }
  ]
}
