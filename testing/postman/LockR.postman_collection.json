  "item": [
    {
      "name": "Setup - Authentication",
      "item": [
        {
          "name": "Login - Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"2024-00001\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Task Requirement 1 - GET /api/lockers/available",
      "item": [
        {
          "name": "TC1.1 - Get Available Lockers (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success flag', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Response contains data object', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data).to.be.an('object');",
                  "    pm.expect(response.data.lockers).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Response has pagination metadata', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data.pagination).to.be.an('object');",
                  "    pm.expect(response.data.pagination).to.have.property('currentPage');",
                  "    pm.expect(response.data.pagination).to.have.property('totalPages');",
                  "    pm.expect(response.data.pagination).to.have.property('totalCount');",
                  "});",
                  "",
                  "pm.test('Each locker has required fields', function () {",
                  "    const response = pm.response.json();",
                  "    if (response.data.lockers.length > 0) {",
                  "        const locker = response.data.lockers[0];",
                  "        pm.expect(locker).to.have.property('lockerID');",
                  "        pm.expect(locker).to.have.property('branchID');",
                  "        pm.expect(locker).to.have.property('floorNumber');",
                  "        pm.expect(locker).to.have.property('status');",
                  "        pm.expect(locker).to.have.property('createdAt');",
                  "        pm.expect(locker).to.have.property('updatedAt');",
                  "    }",
                  "});",
                  "",
                  "pm.test('All lockers have status Available', function () {",
                  "    const response = pm.response.json();",
                  "    response.data.lockers.forEach(locker => {",
                  "        pm.expect(locker.status).to.equal('Available');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lockers/available",
              "host": ["{{base_url}}"],
              "path": ["lockers", "available"]
            }
          }
        },
        {
          "name": "TC1.2 - Get Available Lockers with Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Pagination parameters applied', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data.pagination.currentPage).to.equal(1);",
                  "    pm.expect(response.data.pagination.limit).to.equal(10);",
                  "    pm.expect(response.data.lockers.length).to.be.at.most(10);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lockers/available?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["lockers", "available"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "TC1.3 - Unauthorized Access (No Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/lockers/available",
              "host": ["{{base_url}}"],
              "path": ["lockers", "available"]
            }
          }
        },
        {
          "name": "TC1.4 - Invalid Pagination Parameters",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message present', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.error).to.include('pagination');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lockers/available?page=0&limit=150",
              "host": ["{{base_url}}"],
              "path": ["lockers", "available"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "150"
                }
              ]
            }
          }
        }
      ]
    },
