    {
      "name": "Task Requirement 3 - GET /api/lockers/:lockerID",
      "item": [
        {
          "name": "TC3.1 - Get Locker by ID (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains single locker object', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data.locker).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('Locker has all required fields', function () {",
                  "    const response = pm.response.json();",
                  "    const locker = response.data.locker;",
                  "    pm.expect(locker).to.have.property('lockerID');",
                  "    pm.expect(locker).to.have.property('branchID');",
                  "    pm.expect(locker).to.have.property('floorNumber');",
                  "    pm.expect(locker).to.have.property('status');",
                  "    pm.expect(locker).to.have.property('createdAt');",
                  "    pm.expect(locker).to.have.property('updatedAt');",
                  "});",
                  "",
                  "pm.test('Returned locker ID matches request', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data.locker.lockerID).to.equal('L6-001');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
