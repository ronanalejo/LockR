{
  "info": {
    "name": "LockR Finance API - Updated",
    "_postman_id": "lockr-finance-updated-2026",
    "description": "Finance API tests aligned with formatSuccess/formatError and team notes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "finance_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_reservation_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup - Finance Login",
      "item": [
        {
          "name": "Finance Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"finance.admin@iacademy.edu.ph\",\n  \"password\": \"financepass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.expect(res.success).to.be.true;",
                  "pm.collectionVariables.set('finance_token', res.token);",
                  "pm.expect(res.user.department).to.equal('Finance');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Pending Payments",
      "item": [
        {
          "name": "Get Pending Payments (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{finance_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/finance/payments/pending",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "finance",
                "payments",
                "pending"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.expect(res.success).to.be.true;",
                  "pm.expect(res.data).to.be.an('array');",
                  "if (res.data.length > 0) {",
                  "  pm.collectionVariables.set('test_reservation_id', res.data[0].reservationID);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Verify Payment",
      "item": [
        {
          "name": "Verify Payment (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{finance_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/finance/payments/{{test_reservation_id}}/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "finance",
                "payments",
                "{{test_reservation_id}}",
                "verify"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified successfully', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().success).to.be.true;"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Payment History",
      "item": [
        {
          "name": "Get Payment History (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{finance_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/finance/payments/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "finance",
                "payments",
                "history"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).to.be.an('array');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Finance Stats",
      "item": [
        {
          "name": "Get Finance Stats (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{finance_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/finance/stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "finance",
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stats OK', () => pm.response.to.have.status(200));",
                  "const stats = pm.response.json().data;",
                  "pm.expect(stats).to.have.keys(['total','pending','verified']);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}